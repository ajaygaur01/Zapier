# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://orders_user:testing@localhost:5432/zapier"

# ============================================
# Primary Backend Configuration
# ============================================
# JWT secret key for signing authentication tokens
# IMPORTANT: Use a strong, random string in production
JWT_PASSWORD="123random"

# ============================================
# Worker Service Configuration
# ============================================
# SMTP Configuration for Email Actions
SMTP_ENDPOINT="smtp.example.com"
SMTP_USERNAME="your-email@example.com"
SMTP_PASSWORD="your-smtp-password"

# Solana Configuration for SOL Transfer Actions
# Base58 encoded private key for Solana wallet
# IMPORTANT: Keep this secure and never commit to version control
SOL_PRIVATE_KEY=""

# ============================================
# Kafka Configuration
# ============================================
# Kafka broker addresses (comma-separated for multiple brokers)
# Default: localhost:9092
KAFKA_BROKERS="localhost:9092"

# Silence KafkaJS partitioner warning (optional)
KAFKAJS_NO_PARTITIONER_WARNING=1

# ============================================
# Service URLs (for frontend configuration)
# ============================================
# Backend API URL
BACKEND_URL="http://localhost:3000"

# Hooks service URL
HOOKS_URL="http://localhost:8000"

# ============================================
# Environment-specific Notes
# ============================================
# 1. Copy this file to .env in each service directory:
#    - primary-backend/.env
#    - processor/.env
#    - hooks/.env
#    - worker/.env (if needed)
#
# 2. Update values according to your environment
#
# 3. Never commit .env files to version control
#
# 4. For production, use environment variables or secrets management